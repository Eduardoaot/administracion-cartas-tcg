// Esquema de Bóveda TCG. Cada tabla nace en la fase que la necesita (ver README).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------- Fase 1: usuarios, sesiones, 2FA y auditoría ----------

enum UserStatus {
  active
  blocked
}

enum Role {
  coleccionista
  tienda
  moderador
  admin
}

model User {
  id              String     @id @default(uuid()) @db.Char(36)
  email           String     @unique @db.VarChar(255)
  displayName     String     @map("display_name") @db.VarChar(50)
  passwordHash    String?    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  status          UserStatus @default(active)
  failedLogins    Int        @default(0) @map("failed_logins")
  lockedUntil     DateTime?  @map("locked_until")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  roles         UserRole[]
  refreshTokens RefreshToken[]
  oauthAccounts OauthAccount[]
  mfaFactors    MfaFactor[]
  emailTokens   EmailToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

model UserRole {
  userId    String   @map("user_id") @db.Char(36)
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

/// Un "family_id" es una sesión (un dispositivo). Cada refresh rota el token dentro de la familia.
model RefreshToken {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @map("user_id") @db.Char(36)
  tokenHash        String    @unique @map("token_hash") @db.Char(64)
  familyId         String    @map("family_id") @db.Char(36)
  userAgent        String?   @map("user_agent") @db.VarChar(255)
  ip               String?   @db.VarChar(45)
  sessionStartedAt DateTime  @map("session_started_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  /// rotated | logout | revoked_by_user | reuse_detected | password_reset | blocked
  revokedReason    String?   @map("revoked_reason") @db.VarChar(32)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Preparada para OAuth (Google). El flujo se pospuso: ver README.
model OauthAccount {
  id             String   @id @default(uuid()) @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  provider       String   @db.VarChar(32)
  providerUserId String   @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

enum MfaType {
  totp
  passkey
}

model MfaFactor {
  id              String    @id @default(uuid()) @db.Char(36)
  userId          String    @map("user_id") @db.Char(36)
  type            MfaType
  /// Secreto TOTP cifrado con AES-256-GCM (iv:tag:datos en base64)
  secretEncrypted String?   @map("secret_encrypted") @db.Text
  /// Credencial WebAuthn (fase 8, opcional)
  credential      Json?
  /// Lista de { h: HMAC-SHA256 del código, usedAt: fecha | null }
  backupCodesHash Json?     @map("backup_codes_hash")
  /// Último time step TOTP aceptado; evita reutilizar el mismo código
  lastUsedStep    Int?      @map("last_used_step")
  /// null = configuración iniciada pero no confirmada
  enabledAt       DateTime? @map("enabled_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("mfa_factors")
}

enum EmailTokenType {
  verify_email
  reset_password
}

/// Ajuste propuesto: tokens de un solo uso para verificar correo y recuperar contraseña.
model EmailToken {
  id        String         @id @default(uuid()) @db.Char(36)
  userId    String         @map("user_id") @db.Char(36)
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime       @map("expires_at")
  usedAt    DateTime?      @map("used_at")
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @map("user_id") @db.Char(36)
  action    String   @db.VarChar(64)
  target    String?  @db.VarChar(255)
  ip        String?  @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}
