# Copia este archivo a .env y ajusta lo que necesites:  cp .env.example .env
# Todos los valores tienen un default en docker-compose.yml; .env es opcional en la Fase 0.
# Los valores de abajo son SOLO PARA DESARROLLO. Cámbialos en cualquier entorno compartido.

# --- Puertos publicados en el host (solo 127.0.0.1, salvo web) ---
WEB_HOST_PORT=8080            # Frontend: http://localhost:8080
API_HOST_PORT=4000            # API directa (útil para depurar): http://localhost:4000/health
MYSQL_HOST_PORT=3307          # 3307 para no chocar con un MySQL local
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001  # Consola web de MinIO
MAILPIT_UI_HOST_PORT=8025     # Bandeja de correo de desarrollo
MAILPIT_SMTP_HOST_PORT=1025
OLLAMA_HOST_PORT=11435          # 11435 para no chocar con un Ollama instalado en el equipo

# --- Frontend ---
# Origen permitido por CORS en el api. Debe coincidir con la URL desde donde abres la web.
WEB_ORIGIN=http://localhost:8080

# --- MySQL 8 ---
MYSQL_DATABASE=boveda
MYSQL_USER=boveda
MYSQL_PASSWORD=boveda
MYSQL_ROOT_PASSWORD=root

# --- MinIO (S3 compatible) ---
# La edición comunitaria de MinIO quedó archivada (abr-2026) y ya no publica imágenes Docker.
# Se compila desde el código fuente (infra/minio/Dockerfile). Versión del módulo Go a compilar:
MINIO_VERSION=latest
MINIO_ROOT_USER=boveda
MINIO_ROOT_PASSWORD=boveda-secret-123   # mínimo 8 caracteres

# --- Servicio de IA ---
# cpu  = modo desarrollo, funciona en cualquier equipo (lento para visión)
# cuda = GPU NVIDIA; usa además docker-compose.gpu.yml
# auto = cuda si está disponible, si no cpu
AI_DEVICE=cpu
# Segmentación de cartas: opencv (línea base) | sam3 (desde la Fase 3)
AI_SEGMENTER=opencv
# Instala pytest/ruff en la imagen de IA (true en desarrollo)
AI_INSTALL_DEV=true

# --- Ollama (LLM local) ---
# Nombres verificados en https://ollama.com/library (nov-2026):
#   llama3.2-vision:11b  -> 7.8 GB, capacidad "vision" (lectura de cartas, pre-grado)
#   llama3.2:3b          -> 2.0 GB, capacidad "tools" (copiloto, vigilancia de chat)
# Alternativa de texto más capaz si tienes RAM/VRAM: llama3.1:8b (4.9 GB, tools)
OLLAMA_VISION_MODEL=llama3.2-vision:11b
OLLAMA_TEXT_MODEL=llama3.2:3b
OLLAMA_IMAGE_TAG=latest
OLLAMA_KEEP_ALIVE=10m         # tiempo que un modelo queda cargado en memoria
OLLAMA_MAX_LOADED_MODELS=1    # 1 para equipos con poca memoria
